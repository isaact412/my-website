 log = logging.getLogger("bot.memory")
 
+# Local models refuse to write about someone when the notes are crude/sexual/personal.
+# Those notes are left out of the bible, and a refusal is never saved as a character sheet.
+_TRIGGERS = re.compile(
+    r"\b(sex\w*|porn\w*|nude\w*|naked|horny|jerk\w* off|masturbat\w*|dick|cock|pussy|boob\w*|tits|cum|fetish\w*|"
+    r"kink\w*|lube|condom\w*|virgin\w*|hook(ed)? up|dating|crush|rape\w*|molest\w*|slur\w*|n[i1]gg\w*|f[a4]gg?\w*|"
+    r"retard\w*|kill (him|her|them|myself|yourself)|suicid\w*)\b", re.I)
+_REFUSAL = re.compile(
+    r"^\W*(i\s*(can'?t|cannot|won'?t|am unable|'m unable|'m not able|am not able)|sorry|i apologi[sz]e|"
+    r"as an ai|unfortunately)|i can'?t (help|assist|create|write|provide)|not able to (help|assist|create)", re.I)
+
+
+def clean_for_bible(text: str) -> bool:
+    return not is_sensitive(text) and not _TRIGGERS.search(text)
+
+
+def is_refusal(answer: str) -> bool:
+    return len(answer.split()) < 8 or bool(_REFUSAL.search(answer))
+
+
