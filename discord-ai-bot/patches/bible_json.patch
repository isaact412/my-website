+def read_answer(raw: str, key: str) -> str:
+    """Gets the text out of the model's answer, whether it replied in JSON (as asked) or plain text.
+
+    Some setups force Ollama to always answer in JSON, so the bible asks for JSON on purpose.
+    """
+    raw = (raw or "").strip()
+    start, end = raw.find("{"), raw.rfind("}")
+    if start != -1 and end > start:
+        try:
+            data = json.loads(raw[start:end + 1])
+        except ValueError:
+            data = None
+        if isinstance(data, dict):
+            value = data.get(key)
+            if value is None and len(data) == 1:
+                value = next(iter(data.values()))  # model used a different key name
+            if isinstance(value, list):
+                return "\n".join(str(v).strip() for v in value if str(v).strip())
+            if isinstance(value, str):
+                return value.strip()
+            return ""
+    return raw
+
+
 def clean_for_bible(text: str) -> bool:
